    {
      "name": "GP010269.MP4",
      "type": "secondary",
      "description": "Альтернативное видео"
    }
  ],
  
  "processing_stages": {
    "1_video_analysis": {
      "description": "Загрузка и анализ видео с GoPro",
      "status": "pending"
    },
    "2_metadata_extraction": {
      "description": "Извлечение метаданных из видео",
      "status": "pending"
    },
    "3_satellite_maps": {
      "description": "Загрузка спутниковых карт",
      "status": "pending"
    },
    "4_georeference": {
      "description": "Геореференцирование видеокадров",
